# CIM-Loader Environment Variables Example
# Copy this file to .env and customize for your setup

# =============================================================================
# Common CIM Configuration
# =============================================================================

# CIM profile to use (e.g., rc4_2021, cimhub_2023)
CIMG_CIM_PROFILE=rc4_2021

# CIM namespace
CIMG_NAMESPACE=http://iec.ch/TC57/CIM100#

# IEC 61970-301 version
CIMG_IEC61970_301=8

# Whether to use units
CIMG_USE_UNITS=False

# =============================================================================
# Blazegraph Configuration
# =============================================================================

# Blazegraph SPARQL endpoint URL
CIMG_URL=http://localhost:8889/bigdata/namespace/kb/sparql

# =============================================================================
# Neo4j Configuration
# =============================================================================

# Neo4j connection URL (bolt protocol)
CIMG_URL=neo4j://localhost:7687

# Neo4j host and port
CIMG_HOST=localhost
CIMG_PORT=7687

# Neo4j authentication
CIMG_USERNAME=neo4j
CIMG_PASSWORD=test1234

# Neo4j database name
CIMG_DATABASE=neo4j

# =============================================================================
# MySQL Configuration
# =============================================================================

# MySQL connection details
CIMG_HOST=localhost
CIMG_PORT=3306
CIMG_USERNAME=root
CIMG_PASSWORD=password
CIMG_DATABASE=rc4_2021

# =============================================================================
# Oxigraph Configuration
# =============================================================================

# Oxigraph SPARQL query endpoint
CIMG_URL=http://localhost:7878/query

# =============================================================================
# Notes
# =============================================================================
#
# - Only set CIMG_URL for the database you're using (it's database-specific)
# - For Blazegraph and Oxigraph, CIMG_URL is the SPARQL endpoint
# - For Neo4j, CIMG_URL is the bolt:// connection string
# - For MySQL, use CIMG_HOST/PORT instead of CIMG_URL
# - All tests use these environment variables via cimgraph's get_*() functions
